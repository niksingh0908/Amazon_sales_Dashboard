      <aliases enabled='yes' />
      <column caption='Total orders' datatype='integer' name='[Calculation_0982161992761345]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([Order ID])' />
      </column>
      <column caption='Total Profit' datatype='real' name='[Calculation_1557755946881024]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Total Revenue])-SUM([Total Cost])' />
      </column>
      <column caption='Shipping Days' datatype='integer' name='[Calculation_1557755948814338]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;,[Order Date],[Ship Date])' />
      </column>
      <column caption='Avgerage Shipping Days ' datatype='real' name='[Calculation_1557755949432835]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([Calculation_1557755948814338])' />
      </column>
