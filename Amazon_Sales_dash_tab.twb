                <zone forceUpdate='true' h='5087' id='23' type-v2='text' w='11035' x='84539' y='18114'>
                  <formatted-text>
                    <run fontalignment='1' fontcolor='#000000' fontname='Tableau Medium' fontsize='14'>Insights</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='74814' id='24' type-v2='text' w='24564' x='74688' y='24069'>
                  <formatted-text>
                    <run bold='true' fontcolor='#333333' fontsize='8'>-Revenue peaked in 2012</run>
                    <run fontcolor='#333333' fontsize='8'>Æ </run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#333333' fontsize='8'>The highest revenue was </run>
                    <run bold='true' fontcolor='#333333' fontsize='8'>$555.39M in 2012</run>
                    <run fontcolor='#333333' fontsize='8'>, making it the strongest-performing year. </run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#333333' fontsize='8'>Revenue declined significantly after 2012</run>
                    <run fontcolor='#333333' fontsize='8'>Æ </run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#333333' fontsize='8'>Revenue generally fell from </run>
                    <run bold='true' fontcolor='#333333' fontsize='8'>$555.39M in 2012</run>
                    <run fontcolor='#333333' fontsize='8'> to </run>
                    <run bold='true' fontcolor='#333333' fontsize='8'>$152.41M in 2017</run>
                    <run fontcolor='#333333' fontsize='8'>, a decline of about </run>
                    <run bold='true' fontcolor='#333333' fontsize='8'>72.6%</run>
                    <run fontcolor='#333333' fontsize='8'>. </run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#333333' fontsize='8'>Shipping performance improved overall</run>
                    <run fontcolor='#333333' fontsize='8'>Æ </run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#333333' fontsize='8'>Average shipping days decreased from </run>
                    <run bold='true' fontcolor='#333333' fontsize='8'>25.3 days in 2010</run>
                    <run fontcolor='#333333' fontsize='8'> to </run>
                    <run bold='true' fontcolor='#333333' fontsize='8'>18.9 days in 2017</run>
                    <run fontcolor='#333333' fontsize='8'>, showing improved operational efficiency. </run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#333333' fontsize='8'>2017 had the fastest shipping but the lowest revenue</run>
                    <run fontcolor='#333333' fontsize='8'>Æ </run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#333333' fontsize='8'>Despite achieving the </run>
                    <run bold='true' fontcolor='#333333' fontsize='8'>lowest average shipping time of 18.9 days</run>
                    <run fontcolor='#333333' fontsize='8'>, 2017 also recorded the </run>
                    <run bold='true' fontcolor='#333333' fontsize='8'>lowest revenue of $152.41M</run>
                    <run fontcolor='#333333' fontsize='8'>. </run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#333333' fontsize='8'>No clear direct relationship between shipping speed and revenue</run>
                    <run fontcolor='#333333' fontsize='8'>Æ </run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#333333' fontsize='8'>Faster shipping did </run>
                    <run bold='true' fontcolor='#333333' fontsize='8'>not consistently lead to higher revenue</run>
                    <run fontcolor='#333333' fontsize='8'>. This suggests other factors—such as </run>
                    <run bold='true' fontcolor='#333333' fontsize='8'>sales volume, pricing, customer demand, or product mix</run>
                    <run fontcolor='#333333' fontsize='8'>—had a greater impact on revenue.</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
