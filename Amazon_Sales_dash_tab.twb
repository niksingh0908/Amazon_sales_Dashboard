                <zone fixed-size='280' h='82878' id='22' is-fixed='true' name='Revenue and Shipment Days Analysis' w='73130' x='-62' y='16377'>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
